{
  "name": "zekivo-gateway",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm --filter @zekivo/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "local:up": "docker compose up --build -d",
    "local:down": "docker compose down",
    "local:reset": "node scripts/reset-local.mjs",
    "local:seed-chain": "tsx packages/testkit/src/seed-chain.ts",
    "local:pay": "tsx packages/testkit/src/pay-invoice.ts",
    "local:smoke": "tsx packages/testkit/src/smoke.ts",
    "local:webhook-smoke": "tsx packages/testkit/src/webhook-smoke.ts",
    "test:checkout": "playwright test --grep-invert @chain",
    "test:checkout:chain": "LOCAL_CHAIN_E2E=1 playwright test --project desktop --grep @chain",
    "local:playground": "tsx packages/testkit/src/playground-server.ts",
    "devnet:setup": "tsx packages/devnet/src/server.ts",
    "devnet:init": "tsx packages/devnet/src/init.ts",
    "devnet:provision": "tsx packages/devnet/src/provision.ts",
    "devnet:up": "docker compose --env-file .env.devnet -f compose.devnet.yaml up --build -d",
    "devnet:invoice": "tsx packages/devnet/src/invoice.ts",
    "devnet:inspect": "tsx packages/devnet/src/inspect.ts",
    "local:notification-smoke": "tsx packages/testkit/src/notification-smoke.ts",
    "local:refund-smoke": "tsx packages/testkit/src/refund-smoke.ts",
    "devnet:refund-inspect": "tsx packages/devnet/src/refund-inspect.ts",
    "pricing:inspect": "tsx packages/pricing/src/inspect.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "dotenv": "^17.0.0",
    "fastify": "5.12.7",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.1.1",
    "openid-client": "^6.8.8",
    "pg": "8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@solana/wallet-standard-features": "^1.5.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
