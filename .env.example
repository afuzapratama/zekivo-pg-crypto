APP_ENV=local
SOLANA_CLUSTER=localnet
DATABASE_URL=postgres://gateway:localdev@localhost:55432/gateway
PORT=4100
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3100
# Server-side web proxy; Compose overrides this with http://api:4100
API_INTERNAL_URL=http://127.0.0.1:4100
SOLANA_RPC_URL=http://127.0.0.1:8899
CHAIN_MONITORING=true
WEBHOOK_DELIVERY=true
WEBHOOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOCAL_WEBHOOK_URL=http://127.0.0.1:4200/webhooks/zekivo
LOCAL_WEBHOOK_SECRET=whsec_local_development_only
LOCAL_RECEIVER_CONTROL_TOKEN=local_receiver_control_only

# Dedicated local-only playground runner (pnpm local:playground):
LOCAL_PLAYGROUND_TOKEN=local_playground_control_only
LOCAL_GATEWAY_URL=http://127.0.0.1:4100
# Native Next.js must receive these through its process environment; Compose sets them.
# LOCAL_PLAYGROUND=true
# LOCAL_PLAYGROUND_URL=http://127.0.0.1:4300

# Optional public API URL for Scalar outside localnet (no credentials in this URL).
# API_PUBLIC_URL=https://api.your-staging-domain.example

# Localnet defaults; Devnet uses .env.devnet generated by devnet:init.
ENABLED_ASSETS=USDT,USDC
SCAN_INTERVAL_MS=1000

# Admin Entra OIDC (disabled until configured; no development login bypass)
ADMIN_AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# JSON object: immutable Entra user object ID -> admin/operator/read-only
ADMIN_ALLOWED_IDENTITIES={}

# Shared only by API + worker; generate 32 random bytes as 64 hex characters.
# NOTIFICATION_ENCRYPTION_KEY=

# Only enable on a local Devnet deployment to allow Mailpit on port 1025.
LOCAL_MAILPIT_ENABLED=false

# Reference prices: fixture by default; coingecko-demo is for dev/staging only.
PRICING_PROVIDER=fixture
COINGECKO_DEMO_API_KEY=
PRICING_CACHE_TTL_SECONDS=60
PRICING_MAX_AGE_SECONDS=180
PRICING_MONTHLY_BUDGET=9000
